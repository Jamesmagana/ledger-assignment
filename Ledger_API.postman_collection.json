			"item": [
				{
					"name": "Post Journal Entry - Sale Transaction",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    pm.environment.set(\"journalEntryId\", response.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{authToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"externalId\": \"SALE-001\",\n    \"lines\": [\n        {\n            \"accountId\": \"{{arAccountId}}\",\n            \"direction\": 1,\n            \"amount\": 1000.00\n        },\n        {\n            \"accountId\": \"{{salesAccountId}}\",\n            \"direction\": 2,\n            \"amount\": 1000.00\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/journalentries",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"journalentries"
							]
						},
						"description": "Posts a journal entry for a sale transaction. Debit AR, Credit Sales. Direction: 1=Debit, 2=Credit. Must be double-entry balanced."
					},
					"response": []
				},
